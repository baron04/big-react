    "rollup": "^4.24.0",
    "rollup-plugin-generate-package-json": "^3.2.0",
    "rollup-plugin-typescript2": "^0.36.0",
    "typescript": "5.5.4",
    "typescript-eslint": "^8.8.1",
    "vite": "^5.4.8"
  },
  "dependencies": {
    "scheduler": "^0.23.2"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,jsx,tsx}": [
